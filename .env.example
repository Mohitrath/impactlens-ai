# Required for signed Cloudinary uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudinary Analyze API model. Examples include captioning or ai_vision_general.
# The selected model must be enabled in your Cloudinary account.
CLOUDINARY_ANALYSIS_MODEL=ai_vision_general
